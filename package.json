{
  "name": "backend",
  "packageManager": "yarn@4.14.1",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "yarn workspaces foreach -A -parallel run start:dev",
    "gateway:dev": "yarn workspace api-gateway run start:dev",
    "auth:dev": "yarn workspace auth-service run start:dev",
    "user:dev": "yarn workspace user-service run start:dev"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "typescript": "5"
  }
}
